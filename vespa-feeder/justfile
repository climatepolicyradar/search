test:
    uv run pytest

build:
    #!/usr/bin/env bash
    set -euo pipefail
    registry="$(aws sts get-caller-identity --query Account --output text).dkr.ecr.$(aws configure get region 2>/dev/null || echo $AWS_DEFAULT_REGION).amazonaws.com"
    docker build --platform=linux/amd64 -t "$registry/search-vespa-feeder:latest" .

push:
    #!/usr/bin/env bash
    set -euo pipefail
    registry="$(aws sts get-caller-identity --query Account --output text).dkr.ecr.$(aws configure get region 2>/dev/null || echo $AWS_DEFAULT_REGION).amazonaws.com"
    aws ecr get-login-password | docker login --username AWS --password-stdin "$registry"
    docker push "$registry/search-vespa-feeder:latest"

# PYTHONPATH mirrors the Dockerfile, so the flow modules import by the same
# names here as they do in the image - which matters because Prefect stores a
# deployment's entrypoint as a module name rather than a path.
deploy:
    PYTHONPATH=src uv run python deployments.py
