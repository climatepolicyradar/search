# Default query rewrites for document search (and any query not using
# `rules.rulebase=labels`).
# Title acronyms live here (semantic rules apply to default / unlabeled query terms).
# Geography aliases stay in Lucene en/geo-synonyms.txt (see lucene-linguistics/README.md).
# See https://docs.vespa.ai/en/linguistics/query-rewriting.html

@language(en)
@default

# Title acronyms & variants (formerly lucene-linguistics/en/title-synonyms.txt)
# TO-DO: update the rules to align with nz (see below). Not done yet because tests expect 
# specific documents, which is based of the following rules i.e. documents expected would
# also need updating.
tcfd +> ?"task force climate related financial disclosures";
fca -> financial conduct authority;
ira -> inflation reduction act;
sfdr -> sustainable finance disclosure regulation;
erp -> emissions reduction plan;
necp -> national energy and climate plan;
phaseout -> phase out;

# Many climate/energy laws are titled "... act ..."
law +> ?act;

# Geo synonyms (Lucene en/geo-synonyms.txt) resolve "nz" -> "new zealand".
# Adding here only affects the default fieldset (title/description/passages).
nz +> ?"net zero";

# We want a query containing 'nz' to be re written to 'nz' or 'net zero', hence the rule.
# It was previously nz +> ?net ?zero which meant a query containing 'nz' was
# re-written to 'nz' or 'net' or 'zero' which was too vague.
# "net zero" is still tokenised so that results include 'net-zero', for example.
