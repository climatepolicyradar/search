schema passages {
    document passages {
        field id type string {
            indexing: attribute | summary
        }
        field idx type int {
            indexing: attribute | summary
        }
        field language type string {
            indexing: attribute | summary
        }
        field content type string {
            indexing: index | summary
            index: enable-bm25
            stemming: multiple
            linguistics {
                profile: passage_analysis
            }
        }
        field looks_like_short_heading type bool {
            indexing: attribute | summary
        }
        field looks_like_table_of_contents type bool {
            indexing: attribute | summary
        }
        field looks_like_reference_list type bool {
            indexing: attribute | summary
        }

        field is_page_header_or_footer type bool {
            indexing: attribute | summary
        }

        field document_id type string {
            indexing: attribute | summary
        }
        field document_ref type reference<documents> {
            indexing: attribute
        }
        field principal_document_ref type reference<documents> {
            indexing: attribute
        }
        field content_type type string {
            indexing: attribute | summary
        }
        field type_confidence type double {
            indexing: attribute | summary
        }
        struct coordinate {
            field x type float {}
            field y type float {}
        }
        struct bounding_box {
            field coordinates type array<coordinate> {}
        }
        struct page_boxes {
            field number type int {}
            field bounding_boxes type array<bounding_box> {}
        }
        field pages type array<page_boxes> {
            indexing: summary
            struct-field number {
                indexing: attribute
                attribute: fast-search
                rank: filter
            }
        }
        field heading_id type string {
            indexing: attribute | summary
        }
        struct label {
            # These are the core Label fields i.e. the node
            field id type string {}
            field type type string {}
            field value type string {}
            
            # These are fields that related the label to the passage i.e. the edge
            field classifier_id type string {}
            field end_index type float {}
            field labelled_text type string {}
            field labellers type array<string> {}
            field prediction_probability type float {}
            field start_index type float {}
            field timestamps type array<string> {}
        }
        field labels type array<label> {
            struct-field id {
                indexing: summary | attribute
                attribute: fast-search
            }
            struct-field type {
                indexing: summary | attribute
                attribute: fast-search
            }
            struct-field value {
                indexing: summary | attribute
                attribute: fast-search
            }
            struct-field classifier_id {
                indexing: summary
            }
            struct-field end_index {
                indexing: summary
            }
            struct-field labelled_text {
                indexing: summary
            }
            struct-field labellers {
                indexing: summary
            }
            struct-field prediction_probability {
                indexing: summary
            }
            struct-field start_index {
                indexing: summary
            }
            struct-field timestamps {
                indexing: summary
            }
        }
        # Mention counts per concept, keyed by the same `concept::Q...` ids as
        # `labels.id`. Held as a tensor so it can be dot-producted with a
        # query-side topic tensor in ranking, which `array<label>` cannot be.
        field concept_counts type tensor<float>(concept{}) {
            indexing: attribute | summary
        }

        field heading_text type string {
            indexing: index | summary
        }

        field passage_source type string {
            indexing: summary
        }
    }

    # Fields imported from the parent document via document_ref. These let us
    # filter and group passages on document-level metadata without denormalising it
    # onto each passage.
    import field document_ref.principal_id as principal_id {}
    import field document_ref.geographies_attribute as geographies {}
    import field document_ref.labels_type_id_value_attribute as labels_type_id_value_attribute {}
    import field document_ref.attributes_published_date as attributes_published_date {}

    # Fields imported from the Principal document via principal_document_ref.
    # Lets passages filter / group / return Principal-scoped metadata in one
    # hop without denormalising per-passage.
    import field principal_document_ref.title_attribute as principal_title {}

    fieldset default {
        fields: content
    }

    rank-profile nativerank {
        inputs{
            query(short_heading_weight) double: 0.15
            query(table_of_contents_weight) double: 0.35
            query(reference_list_weight) double: 0.5
            query(topic_q) tensor<float>(concept{})
            query(topic_weight) double: 1.0
            query(page_header_or_footer_weight) double: 0.5
        }

        function text_score() {
            expression: nativeRank(content) + nativeProximity(content)
        }
        function short_headings_penalty() {
            expression: query(short_heading_weight) * attribute(looks_like_short_heading)
        }
        function table_of_contents_penalty() {
            expression: query(table_of_contents_weight) * attribute(looks_like_table_of_contents)
        }
        function reference_list_penalty() {
            expression: query(reference_list_weight) * attribute(looks_like_reference_list)
        }
        function page_header_or_footer_penalty() {
            expression: query(page_header_or_footer_weight) * attribute(is_page_header_or_footer)
        }
        # `min(x, 1)` for a boolean match of topics
        # Note: this scores how many of the
        # filtered topics a passage carries, not how often it mentions them.
        # It assumes passage topic filters are ORed. Under an AND filter every hit
        # carries every filtered topic, so the score is constant and ranks nothing.
        function topic_score() {
            expression: query(topic_weight) * sum(map(attribute(concept_counts), f(x)(min(x, 1))) * query(topic_q))
        }
        first-phase {
            expression: text_score() - short_headings_penalty - table_of_contents_penalty - reference_list_penalty - page_header_or_footer_penalty + topic_score()
        }
        summary-features: text_score() topic_score() nativeRank(content) nativeProximity(content) attribute(looks_like_short_heading) attribute(looks_like_table_of_contents) attribute(looks_like_reference_list) attribute(is_page_header_or_footer)
    }

    rank-profile bm25_multiplicative inherits nativerank {
        inputs {
            query(prox_weight) double: 2.0
        }

        function text_score() {
            expression: bm25(content)
        }
        function proximity_boost() {
            expression: 1 + query(prox_weight) * nativeProximity(content)
        }
        rank-properties {
            # Placeholder mid-band value, NOT a chosen one - the simulated usable
            # band is 0.25-0.5 and the real sweep has not run yet. k1 is left at
            # Vespa's default because it cancels for single-token queries
            bm25(content).b: 0.4
        }
        # `topic_score` is added to `text_score` so it can act independently – i.e. when
        # there is no search string.
        first-phase {
            expression: (text_score() * proximity_boost + topic_score()) * (1 - short_headings_penalty) * (1 - table_of_contents_penalty) * (1 - reference_list_penalty) * (1 - page_header_or_footer_penalty)
        }

        summary-features: text_score() topic_score() proximity_boost bm25(content) fieldLength(content) nativeProximity(content) attribute(content_type) attribute(looks_like_short_heading) attribute(looks_like_table_of_contents) attribute(looks_like_reference_list) attribute(is_page_header_or_footer)
    }

    document-summary debug-summary {
        summary id {}
        summary idx {}
        summary language {}
        summary content {}
        summary looks_like_short_heading {}
        summary looks_like_table_of_contents {}
        summary looks_like_reference_list {}
        summary is_page_header_or_footer {}
        summary document_id {}
        summary principal_id {}
        summary content_type {}
        summary type_confidence {}
        summary pages {}
        summary heading_id {}
        summary labels {}
        summary heading_text {}
        summary text_tokens {
            source: content
            tokens
        }
        from-disk
    }
}
