<services version="1.0" xmlns:deploy="vespa" xmlns:preprocess="properties">

    <!--
        A container cluster handles incoming requests to the application and processes those requests,
        and their results. The processing to do and the API's to expose can be provides by Vespa
        or by the application through Java components supplied as part of the application.

        See:
          - Reference: https://docs.vespa.ai/en/reference/services-container.html
    -->
    <container id="default" version="1.0">

        <!-- Lucene Linguistics: per-field analyzer profiles -->
        <component id="com.yahoo.language.lucene.LuceneLinguistics"
                   bundle="lucene-linguistics">
            <config name="com.yahoo.language.lucene.lucene-analysis">
                <configDir>lucene-linguistics</configDir>
                <analysis>
                    <!-- title_analysis: stem but keep all tokens (no stop words) -->
                    <item key="profile=title_analysis;language=en">
                        <tokenizer>
                            <name>standard</name>
                        </tokenizer>
                        <tokenFilters>
                            <item>
                                <name>lowercase</name>
                            </item>
                            <item>
                                <name>snowballPorter</name>
                                <conf>
                                    <item key="language">English</item>
                                </conf>
                            </item>
                        </tokenFilters>
                    </item>
                    <!-- title_index_analysis: passage_analysis plus acronym+ordinal
                         splitting.

                         WHY: UNFCCC titles are full of "<acronym><ordinal>" tokens -
                         "BTR1", "NDC1", "NDC3.0", "BUR2", "NC3", "NAP3" - which the
                         standard tokenizer keeps whole, so a search for "BTR" matched
                         none of them (FUS-326). wordDelimiterGraph splits on the
                         numeric boundary and preserveOriginal keeps the whole token,
                         so "BTR1" indexes as both `btr` and `btr1`.

                         KNOWN SIDE EFFECT: this also splits chemical formulae, so
                         "CO2" indexes as `co` + `co2` and "NO2" as `no` + `no2`. The
                         effect is one-way, NOT an equivalence: a query for "CO2" is
                         still exact (the query side does not split, so it matches only
                         `co2`), but a query for the bare "CO" now also matches CO2
                         titles. Judged acceptable because bare two-letter queries are
                         rare. Ranking is not distorted: preserveOriginal emits at the
                         same position, so field length is unchanged - measured
                         fieldMatch(title).fieldCompleteness and bm25(title) are
                         identical for "CO2 capture storage strategy" and "carbon
                         capture storage strategy". The only ranking effect is that
                         `co`/`no` get a slightly higher document frequency, which
                         lowers their IDF and so reduces their influence.

                         Deliberately NOT applied to passage_analysis: splitting
                         numerics across long-form passage text would multiply that
                         side effect over every body paragraph and shift passage bm25
                         statistics. -->
                    <item key="profile=title_index_analysis;language=en">
                        <tokenizer>
                            <name>standard</name>
                        </tokenizer>
                        <charFilters>
                            <item>
                                <name>patternReplace</name>
                                <conf>
                                    <item key="pattern">[$]</item>
                                    <item key="replacement">dollar</item>
                                </conf>
                            </item>
                            <item>
                                <name>patternReplace</name>
                                <conf>
                                    <item key="pattern">[€]</item>
                                    <item key="replacement">euro</item>
                                </conf>
                            </item>
                            <item>
                                <name>patternReplace</name>
                                <conf>
                                    <item key="pattern">[£]</item>
                                    <item key="replacement">pound</item>
                                </conf>
                            </item>
                        </charFilters>
                        <tokenFilters>
                            <item>
                                <name>lowercase</name>
                            </item>
                            <!-- generateNumberParts is off so this does one job:
                                 "BTR1" -> btr + btr1, with no bare "1" token.

                                 splitOnCaseChange is set to 0 for intent, but note it
                                 is INERT here either way: `lowercase` runs above, so
                                 no case information survives to this filter. Verified
                                 by deploying with splitOnCaseChange=1 - "ExxonMobil"
                                 and "PowerUp" still index whole. Moving this filter
                                 above `lowercase` would make the flag live, and would
                                 start splitting the ~1.6k CamelCase entity names in
                                 the corpus (ExxonMobil, WildEarth, ClientEarth,
                                 KlimaSeniorinnen). Don't reorder without deciding
                                 that deliberately. -->
                            <item>
                                <name>wordDelimiterGraph</name>
                                <conf>
                                    <item key="generateWordParts">1</item>
                                    <item key="generateNumberParts">0</item>
                                    <item key="splitOnNumerics">1</item>
                                    <item key="splitOnCaseChange">0</item>
                                    <item key="catenateWords">0</item>
                                    <item key="catenateNumbers">0</item>
                                    <item key="catenateAll">0</item>
                                    <item key="stemEnglishPossessive">0</item>
                                    <item key="preserveOriginal">1</item>
                                </conf>
                            </item>
                            <!-- Required after wordDelimiterGraph in an INDEX analyzer:
                                 the graph it emits has to be flattened before indexing. -->
                            <item>
                                <name>flattenGraph</name>
                            </item>
                            <item>
                                <name>stop</name>
                                <conf>
                                    <item key="words">en/stopwords.txt</item>
                                    <item key="ignoreCase">true</item>
                                </conf>
                            </item>
                            <item>
                                <name>snowballPorter</name>
                                <conf>
                                    <item key="language">English</item>
                                </conf>
                            </item>
                        </tokenFilters>
                    </item>
                    <!-- passage_analysis: stop words + stemming for long-form text.
                         charFilters map currency symbols to words so the
                             standard tokenizer preserves them, e.g. "$100" ->
                             "dollar100". Replacement values must not
                             contain whitespace - Vespa silently ignores a
                             charFilter whose replacement has a space. -->
                    <item key="profile=passage_analysis;language=en">
                        <tokenizer>
                            <name>standard</name>
                        </tokenizer>
                        <charFilters>
                            <item>
                                <name>patternReplace</name>
                                <conf>
                                    <item key="pattern">[$]</item>
                                    <item key="replacement">dollar</item>
                                </conf>
                            </item>
                            <item>
                                <name>patternReplace</name>
                                <conf>
                                    <item key="pattern">[€]</item>
                                    <item key="replacement">euro</item>
                                </conf>
                            </item>
                            <item>
                                <name>patternReplace</name>
                                <conf>
                                    <item key="pattern">[£]</item>
                                    <item key="replacement">pound</item>
                                </conf>
                            </item>
                        </charFilters>
                        <tokenFilters>
                            <item>
                                <name>lowercase</name>
                            </item>
                            <item>
                                <name>stop</name>
                                <conf>
                                    <item key="words">en/stopwords.txt</item>
                                    <item key="ignoreCase">true</item>
                                </conf>
                            </item>
                            <item>
                                <name>snowballPorter</name>
                                <conf>
                                    <item key="language">English</item>
                                </conf>
                            </item>
                        </tokenFilters>
                    </item>
                    <!-- document_label_analysis: lowercase only, no stemming -->
                    <item key="profile=document_label_analysis;language=en">
                        <tokenizer>
                            <name>standard</name>
                        </tokenizer>
                        <tokenFilters>
                            <item>
                                <name>lowercase</name>
                            </item>
                        </tokenFilters>
                    </item>
                    <!-- label_analysis: lowercase, stemming -->
                    <item key="profile=label_analysis;language=en">
                        <tokenizer>
                            <name>standard</name>
                        </tokenizer>
                        <tokenFilters>
                            <item>
                                <name>lowercase</name>
                            </item>
                            <item>
                                <name>snowballPorter</name>
                                <conf>
                                    <item key="language">English</item>
                                </conf>
                            </item>
                        </tokenFilters>
                    </item>
                    <!-- geo_analysis: lowercase + stemming, for index time -->
                    <item key="profile=geo_analysis;language=en">
                        <tokenizer>
                            <name>standard</name>
                        </tokenizer>
                        <tokenFilters>
                            <item>
                                <name>lowercase</name>
                            </item>
                            <item>
                                <name>porterStem</name>
                            </item>
                        </tokenFilters>
                    </item>
                    <!-- geo_analysis_search: lowercase + geography synonyms + stemming, for search time -->
                    <item key="profile=geo_analysis_search;language=en">
                        <tokenizer>
                            <name>standard</name>
                        </tokenizer>
                        <tokenFilters>
                            <item>
                                <name>lowercase</name>
                            </item>
                            <item>
                                <name>synonymGraph</name>
                                <conf>
                                    <item key="synonyms">en/geo-synonyms.txt</item>
                                </conf>
                            </item>
                            <item>
                                <name>porterStem</name>
                            </item>
                        </tokenFilters>
                    </item>
                </analysis>
            </config>
        </component>

        <!--
            <document-api> tells the container that it should accept documents for indexing. Through the
            Document REST API you can PUT new documents, UPDATE existing documents, and DELETE documents
            already in the cluster.

            Documents sent to the Document REST API will be passed through document processors on the way
            to the content cluster.

            See:
             - Reference: https://docs.vespa.ai/en/reference/services-container.html#document-api
             - Operations: https://docs.vespa.ai/en/document-v1-api-guide.html
        -->
        <clients>
            <!-- Certificate based auth (required by Vespa Cloud) -->
            <client id="default" permissions="read,write">
                <certificate file="security/clients.pem"/>
            </client>
            <!-- Token based auth-->
            <client id="search-production-read" permissions="read" deploy:application="search">
                <token id="search-production-read"/>
            </client>
            <client id="search-production-write" permissions="read,write" deploy:application="search">
                <token id="search-production-write"/>
            </client>
            <!-- Shared write token for feeding personal dev instances (search-dev
                 application only) from a headless Prefect worker - see
                 vespa-dev/feed_from_production.py. Scoped to search-dev so this
                 token can never be used to write to production. -->
            <client
                id="search-dev-write"
                permissions="read,write"
                deploy:application="search-dev"
            >
                <token id="search-dev-write"/>
            </client>
            <client
                id="search-dev-read"
                permissions="read"
                deploy:application="search-dev"
            >
                <token id="search-dev-read"/>
            </client>
            <client id="vespa-metrics-reader" permissions="read">
                <certificate file="security/vespa-metrics-reader.pem"/>
            </client>
            <client id="katy" permissions="read">
                <certificate file="security/katy.pem"/>
            </client>
        </clients>
        <document-api>
            <!-- TODO: temporary - the data-lake passages export
                 (pipeline_data_in_vespa_passage_updates_v1) includes columns
                 (tokens, serialised_text, passage_source, topics) not yet
                 modelled in passages.sd. Remove this once those fields are
                 either properly added to the schema or stripped upstream. -->
            <ignore-undefined-fields>true</ignore-undefined-fields>
        </document-api>

        <!--
            <search> tells the container to answers queries and serve results for those queries.
            Inside the <search /> cluster you can configure chains of "searchers" -
            Java components processing the query and/or result.

            See:
             - Reference: https://docs.vespa.ai/en/query-api.html
             - Searchers: https://docs.vespa.ai/en/searcher-development.html
        -->
        <search/>

        <!--
            <nodes> specifies the nodes that should run this cluster.
        -->
        <nodes deploy:instance="search-production" count="2">
            <resources vcpu="2" memory="8Gb" disk="50Gb"/>
        </nodes>
    </container>

    <!--
        <content/> content clusters store application data, maintain indexes and executes the
        distributed parts of a query.

        See:
          - Reference: https://docs.vespa.ai/en/reference/services-content.html
    -->
    <content id="search-production" version="1.0">
        <min-redundancy>2</min-redundancy>
        <documents>
            <document type="documents" mode="index" global="true" />
            <document type="passages" mode="index" global="true" />
            <document type="labels" mode="index" global="true" />
        </documents>

        <nodes deploy:instance="search-production" count="2">
            <resources vcpu="2" memory="16Gb" disk="118Gb"/>
        </nodes>
    </content>
</services>
